cat > .gitignore <<'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
.env/

# Reports with possible private metadata
reports/*.txt
reports/*.json
reports/*.csv

# Backups
backups/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF

# App generated/private folders
outputs/
reports/
samples/
backups/
test_images/
private_images/
pictures/

# Editor/OS files
*.bak
*.save
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
